"""Bound tests for CONN-CADDY-MCP-SDK-CENTRALIZATION (generated by connector_codemod --sdk-centralize)."""

import pathlib
import tomllib

import httpx

import caddy_mcp.api.api_client_base as base_module


def _client(handler):
    from scion_sdk.http.client import create_http_client as real

    def build(options):
        return real(options, transport=httpx.MockTransport(handler))

    original = base_module.create_http_client
    base_module.create_http_client = build
    try:
        return base_module.ApiClientBase(base_url="https://service.example.invalid", token="runtime-value")
    finally:
        base_module.create_http_client = original


# spec: CONN-CADDY-MCP-SDK-CENTRALIZATION-R001, CONN-CADDY-MCP-SDK-CENTRALIZATION-R003
def test_request_goes_through_the_governed_client():
    seen = []

    def handler(request):
        seen.append(request)
        return httpx.Response(200, json={"ok": True})

    client = _client(handler)
    assert isinstance(client._session, httpx.Client)
    client.request("GET", "/ping")
    assert seen
    assert seen[0].url.path.endswith("/ping")
    assert seen[0].headers["Authorization"] == "Bearer runtime-value"


# spec: CONN-CADDY-MCP-SDK-CENTRALIZATION-R003
def test_transient_status_is_retried_by_the_sdk_client(monkeypatch):
    monkeypatch.setattr("time.sleep", lambda _s: None)
    calls = []

    def handler(request):
        calls.append(request)
        if len(calls) == 1:
            return httpx.Response(503, headers={"Retry-After": "0"})
        return httpx.Response(200, json={"ok": True})

    _client(handler).request("GET", "/ping")
    assert len(calls) == 2


# spec: CONN-CADDY-MCP-SDK-CENTRALIZATION-R002
def test_dependencies_have_no_unused_requests_pin():
    root = pathlib.Path(__file__).resolve().parents[1]
    deps = tomllib.loads((root / "pyproject.toml").read_text())["project"]["dependencies"]
    assert any(d.startswith("scion-sdk") for d in deps)
    assert not any(d.lower().startswith("requests") for d in deps)
